PORT=3001
DB_PATH=data/meridian.sqlite
FLIGHT_SOURCE=mock-aidx
AI_PROVIDER=offline-template
# For phone QR use http://YOUR-LAN-IP:3001 when running npm start.
# For Vite dev use http://YOUR-LAN-IP:5173.
# For a public host use its verified HTTPS URL.
PUBLIC_BASE_URL=
PUBLIC_PORT=3001

