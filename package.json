{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "preview": "node scripts/start.mjs",
    "lint": "node scripts/check.mjs && prettier --check apps packages scripts tests vite.config.ts tsconfig.json playwright.config.ts package.json",
    "format": "prettier --write apps packages scripts tests vite.config.ts tsconfig.json playwright.config.ts package.json",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
